root ::= "{\"notes\":[" s0 "]}"
s0 ::= n2 "," s2 | n3 "," s4
s2 ::= n3 "," s6
s4 ::= n2 "," s6
s6 ::= n1
w1 ::= "Time in target 95 percent."
a1 ::= "nothing flagged"
n1 ::= "{\"cot\":1,\"action\":\"" a1 "\",\"why\":\"" w1 "\"}"
w2 ::= f2 (" and " f2){0,1} " " v2 " the nurse should " a2 "."
v2 ::= "mean" | "means"
f2 ::= [fF] "requent desaturations" | [rR] "ising need" | [rR] "ising oxygen need"
a2 ::= "review respiratory support"
n2 ::= "{\"cot\":2,\"action\":\"" a2 "\",\"why\":\"" w2 "\"}"
w3 ::= f3 (" and " f3){0,2} " " v3 " the nurse should " a3 (" and " a3)? "."
v3 ::= "mean" | "means"
f3 ::= [fF] "requent desaturations" | [pP] "robe trouble" | [uU] "nreliable readings" | [hH] "old or fallback"
a3 ::= "review respiratory support" | "check the probe site" | "check the system"
n3 ::= "{\"cot\":3,\"action\":\"" a3 "\",\"why\":\"" w3 "\"}"
