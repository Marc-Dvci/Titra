{
  "description": "Fault injection cases and their budgets. Times are measured on the host clock from the moment the bench injects the fault. A missed tick is a command interval longer than missed_tick_s.",
  "missed_tick_s": 1.5,
  "cots": 3,
  "warmup_s": 360,
  "observe_s": 120,
  "cases": [
    {"id": "F1", "fault": "sensor_off", "cot": 2, "duration_s": 60,
     "expect": {"alarm_within_s": 2, "fio2_unchanged_while_holding": true, "fallback_within_s": 32}},
    {"id": "F2", "fault": "cable_cut", "cot": 2, "duration_s": 60,
     "expect": {"alarm_within_s": 5, "fio2_unchanged_while_holding": true, "fallback_within_s": 32}},
    {"id": "F3", "fault": "repeat_frame", "cot": 2, "duration_s": 60,
     "expect": {"fallback_within_s": 5}},
    {"id": "F4", "fault": "frozen_values", "cot": 2, "duration_s": 60,
     "expect": {"fallback_within_s": 22}},
    {"id": "F5", "fault": "garbage_line", "cot": 2, "duration_s": 60,
     "expect": {"no_crash": true, "no_fallback": true}},
    {"id": "F6", "fault": "kill_spo2d", "cot": 2,
     "expect": {"alarm_within_s": 2, "resume_within_s": 10, "no_fallback": true}},
    {"id": "F7", "fault": "kill_titractl", "cot": 2,
     "expect": {"alarm_within_s": 5, "resume_within_s": 10, "no_step_at_resume": true}},
    {"id": "F8", "fault": "stop_titractl", "cot": 2,
     "expect": {"alarm_within_s": 5, "resume_within_s": 15}},
    {"id": "F9", "fault": "kill_valved", "cot": 2,
     "expect": {"alarm_within_s": 5, "resume_within_s": 10}},
    {"id": "F10", "fault": "blender_link_cut", "cot": 2, "duration_s": 60,
     "expect": {"alarm_within_s": 5, "fallback_within_s": 17}},
    {"id": "F11", "fault": "bad_command", "cot": 2, "attempts": 100,
     "expect": {"refused_fraction": 1.0}},
    {"id": "F12", "fault": "open_valve_from_other_type", "cot": 1, "attempts": 100,
     "expect": {"refused_fraction": 1.0}},
    {"id": "F13", "fault": "cpu_load", "cot": 0, "duration_s": 300,
     "expect": {"missed_ticks": 0}},
    {"id": "F14", "fault": "kill_titractl", "cot": 2, "watch_cots": [1, 3],
     "expect": {"missed_ticks_on_watched_cots": 0}}
  ]
}
