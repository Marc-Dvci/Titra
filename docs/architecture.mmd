%% Source of docs/architecture.png, the diagram in the README. Rebuild: python scripts/render_diagram.py
flowchart TD
    subgraph HOST["Host"]
        OX["Simulated baby<br/>and oximeter"]
        BL["Simulated blender<br/>own watchdog"]
    end
    subgraph QNX["QNX 8.0 guest"]
        subgraph CPU0["CPU 0: each cot, priority 30"]
            SPO2["spo2d · spo2dN_t<br/>/dev/spo2/N"]
            CTL{{"titractl · titractlN_t<br/>1 Hz"}}
            VALVE["valved · valvedN_t<br/>/dev/valve/N"]
        end
        subgraph CPUS["CPUs 1-3: the advice cluster, below every controller"]
            ADV["advisor · advisor_t<br/>facts, flags, forecast, validator"]
            LLM["llm · llm_t · /dev/llm<br/>Dory, priority 5, user 300"]
            WEIGHTS[("Weights: sealed, read-only<br/>shared memory")]
        end
        STATION["station · station_t<br/>nurse view"]
        HAM["HAM: restarts<br/>and heartbeats"]
    end
    OX -- "$OX" --> SPO2
    SPO2 -- "devctl" --> CTL
    CTL -- "devctl" --> VALVE
    VALVE -- "$BL" --> BL
    CTL -. "status" .-> STATION
    CTL -. "status" .-> ADV
    ADV -- "prompt and grammar" --> LLM
    LLM -- "checked answer" --> ADV
    WEIGHTS -.-> LLM
    ADV -. "advice" .-> STATION
    CTL -. "heartbeat" .-> HAM
    LLM -. "heartbeat" .-> HAM
    STATION -- "refused by policy" --x VALVE
    ADV -- "refused by policy" --x VALVE
    LLM -- "refused by policy" --x VALVE
