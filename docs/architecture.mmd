%% Source of docs/architecture.png, the diagram in the README. Rebuild: python scripts/render_diagram.py
flowchart TD
    subgraph HOST["Host"]
        OX["Simulated baby<br/>and oximeter"]
        BL["Simulated blender<br/>own watchdog"]
    end
    subgraph QNX["QNX 8.0 guest"]
        SPO2["spo2d · spo2dN_t<br/>/dev/spo2/N"]
        CTL{{"titractl · titractlN_t<br/>1 Hz, priority 30"}}
        VALVE["valved · valvedN_t<br/>/dev/valve/N"]
        STATION["station · station_t<br/>nurse view"]
        HAM["HAM: restarts<br/>and heartbeats"]
    end
    OX -- "$OX" --> SPO2
    SPO2 -- "devctl" --> CTL
    CTL -- "devctl" --> VALVE
    VALVE -- "$BL" --> BL
    CTL -. "status" .-> STATION
    CTL -. "heartbeat" .-> HAM
    STATION -- "refused by policy" --x VALVE
