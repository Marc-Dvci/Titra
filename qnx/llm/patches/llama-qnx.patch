+#elif defined(__QNX__)
+#include <sched.h>
+#include <sys/neutrino.h>
+
+// A runmask has one bit per CPU, and the kernel applies it to the calling thread at once.
+static bool ggml_thread_apply_affinity(const bool * mask) {
+    unsigned runmask = 0;
+    for (unsigned i = 0; i < GGML_MAX_N_THREADS && i < 32; i++) {
+        if (mask[i]) {
+            runmask |= 1u << i;
+        }
+    }
+    if (ThreadCtl(_NTO_TCTL_RUNMASK, (void *)(uintptr_t)runmask) == -1) {
+        fprintf(stderr, "warn: failed to set runmask %#x: %s\n", runmask, strerror(errno));
+        return false;
+    }
+    return true;
+}
+
+// NORMAL leaves the thread at the priority it inherited, which is how a host process caps its compute threads.
+static bool ggml_thread_apply_priority(int32_t prio) {
+    struct sched_param p;
+    switch (prio) {
+        case GGML_SCHED_PRIO_LOW:      p.sched_priority = 5;  break;
+        case GGML_SCHED_PRIO_NORMAL:   return true;
+        case GGML_SCHED_PRIO_MEDIUM:   p.sched_priority = 20; break;
+        case GGML_SCHED_PRIO_HIGH:     p.sched_priority = 40; break;
+        case GGML_SCHED_PRIO_REALTIME: p.sched_priority = 60; break;
+        default:                       return true;
+    }
+    int32_t err = pthread_setschedparam(pthread_self(), SCHED_RR, &p);
+    if (err != 0) {
+        fprintf(stderr, "warn: failed to set thread priority %d: %s\n", p.sched_priority, strerror(err));
+        return false;
+    }
+    return true;
+}
+
 #else // unsupported platforms
 
