# Titra's security policy for QNX 8.0, compiled into the image with mkqnximage --secpol=secure --policy=<this file>.
#
# Generated by secpolgenerate on a running Titra image (mkqnximage --secpol=open) while the live bench exercised
# every cot, the fault matrix and the HAM restarts, then edited by hand:
#   - every cot has the rule set that cot 2 needed, so a restart works the same on every cot;
#   - HAM may start every Titra type, so it can restart any driver, controller or the station;
#   - the root shell's connection to valved2_t, used once by the bench during generation, is removed.
# The rules Titra depends on:
#   - titractlN_t may connect to spo2dN_t and valvedN_t of its own cot, and to nothing of another cot;
#   - no other type may connect to any spo2dN_t or valvedN_t (station_t reads /dev/titra/cotN only);
#   - qnx/image/check_policy.py checks both in CI.

# This represents a policy that should allow a system to perform all the
# same actions as have been observed since the policy generator has been
# running.

# There have been one or more uses of secpol_resmgr_attach() that can have
# permissions set for them in the policy. See the mount_point entries at
# the end.

# Don't want any default abilities
type default_rules;
allow default_rules self:ability {};

type console_t;
type default;
type devb_t;
type devb_t__run;
type devc_pty_t;
type devc_pty_t__run;
type devc_t;
type devc_t__run;
type dhcpcd_t;
type dumper_t;
type dumper_t__run;
type fsevmgr_t;
type fsevmgr_t__run;
type ham_t;
type ham_t__run;
type io_sock_t;
type io_sock_t__run;
type io_usb_t;
type mqueue_t;
type mqueue_t__run;
type pci_server_t;
type pipe_t;
type pipe_t__run;
type qconn_t;
type random_t;
type random_t__run;
type slogger_t;
type slogger_t__run;
type spo2d1_t;
type spo2d2_t;
type spo2d3_t;
type sshd_t;
type sshd_t__privsep;
type station_t;
type titractl1_t;
type titractl2_t;
type titractl3_t;
type user_root_t;
type valved1_t;
type valved2_t;
type valved3_t;

ability iofunc/dup allow { root };
ability vfs/mount-blk allow { root };
ability vfs/pregrow allow { root };
ability vfs/relearn allow { root };
ability vfs/stats-clear allow { root };
ability vfs/fs-control allow { root };
ability network/privport allow { root };
ability network/rawsocket allow { root };
ability network/reuseport allow { root };
ability network/ipsec allow { root };
ability network/admin allow { root };
ability network/jailroot allow { root nonroot };

# === Rules for type console_t ============
allow console_t self:ability {
    prot_exec
    pgrp
    map_fixed
};

# === Rules for type default ============
allow_link default {
    /proc/boot/libsecpol.so.1
    /usr/libexec/sshd-auth
};

# === Rules for type devb_t ============
allow_attach devb_t {
    mount:/
    /dev/hd0
    /dev/hd0t177
    /dev/hd0t178
    /dev/hd0t179
    /boot
    /system
    /data
};
allow devb_t self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    prot_exec
    map_fixed
};
allow devb_t self:ability {
    setuid:20
    setgid:20
    mem_lock
    interrupt:14-15
    io:1
    public_channel
    channel_connect:slogger_t,pci_server_t,fsevmgr_t
    settypeid:devb_t__run
};
derive_type devb_t run devb_t__run;

# === Rules for type devb_t__run ============
allow_attach devb_t__run {
    /boot
    /system
    /data
};
allow devb_t__run self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    prot_exec
    map_fixed
};
allow devb_t__run self:ability {
    setuid:20
    setgid:20
};

# === Rules for type devc_pty_t ============
allow_attach devc_pty_t {
    /dev/ttyp0
    /dev/ptyp0
    /dev/ttyp1
    /dev/ptyp1
    /dev/ttyp2
    /dev/ptyp2
    /dev/ttyp3
    /dev/ptyp3
    /dev/ttyp4
    /dev/ptyp4
    /dev/ttyp5
    /dev/ptyp5
    /dev/ttyp6
    /dev/ptyp6
    /dev/ttyp7
    /dev/ptyp7
};
allow devc_pty_t self:ability {
    nonroot
    setuid:37
    setgid:37
    pathspace
    rsrcdbmgr
    prot_exec
    map_fixed
    public_channel
    channel_connect:slogger_t
    settypeid:devc_pty_t__run
};
derive_type devc_pty_t run devc_pty_t__run;

# === Rules for type devc_t ============
allow_attach devc_t {
    /dev/ser1
    /dev/ser2
};
allow devc_t self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    prot_exec
    interrupt:3-4
    io:0
    map_fixed
    public_channel
    settypeid:devc_t__run
};
derive_type devc_t run devc_t__run;

# === Rules for type dhcpcd_t ============
allow dhcpcd_t self:ability {
    nonroot
    spawn
    fork
    prot_exec
    pgrp
    map_fixed
    channel_connect:slogger_t,devb_t,random_t,pipe_t,io_sock_t
    network/privport
    network/rawsocket
    network/admin
    network/jailroot
};
allow dhcpcd_t self:ability {
    setuid:38
    channel_connect:io_sock_t
};

# === Rules for type dumper_t ============
allow_attach dumper_t {
    dumper+:/proc/dumper
};
allow dumper_t self:ability {
    nonroot
    pathspace
    mem_lock
    prot_exec
    dumper
    priority:0-253
    map_fixed
    public_channel
    channel_connect:slogger_t,devb_t
    settypeid:dumper_t__run
};
derive_type dumper_t run dumper_t__run;

# === Rules for type dumper_t__run ============
allow dumper_t__run self:ability {
    nonroot
    priority:0-253
};

# === Rules for type fsevmgr_t ============
allow_attach fsevmgr_t {
    /dev/fsmgr
    /dev/fsnotify
};
allow fsevmgr_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    channel_connect:slogger_t,devb_t
    settypeid:fsevmgr_t__run
};
derive_type fsevmgr_t run fsevmgr_t__run;

# === Rules for type fsevmgr_t__run ============
allow fsevmgr_t__run self:ability {
    nonroot
    channel_connect:devb_t
};

# === Rules for type ham_t ============
allow_attach ham_t {
    /proc/ham
    /proc/ham/.ctl
};
allow ham_t self:ability {
    pathspace
    mem_lock
    spawn
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:dumper_t,ham_t
    settypeid:ham_t__run,spo2d1_t,valved1_t,titractl1_t,spo2d2_t,valved2_t,titractl2_t,spo2d3_t,valved3_t,titractl3_t,station_t
};
derive_type ham_t run ham_t__run;

# === Rules for type ham_t__run ============
allow ham_t__run self:ability {
    spawn
    prot_exec
    priority:0-253
    map_fixed
    settypeid:spo2d1_t,valved1_t,titractl1_t,spo2d2_t,valved2_t,titractl2_t,spo2d3_t,valved3_t,titractl3_t,station_t
};

# === Rules for type io_sock_t ============
allow_attach io_sock_t {
    socket+:/dev/socket/1
    socket+:/dev/socket/2
    socket+:/dev/socket/28
    socket+:/dev/socket/17
    socket+:/dev/socket/38
    socket+:/dev/socket/27
    /dev/tun
    /dev/tap
    /dev/vmnet
    mount:/
    /dev/io-sock
    /dev/bpf
    /dev/netmap
    /dev/pfil
    /dev/pf
};
allow io_sock_t self:ability {
    nonroot
    getid
    pathspace
    rlimit:14
    mem_phys:4273471488-4273475583
    mem_lock
    prot_exec
    interrupt:256-258
    io:0
    map_fixed
    public_channel
    able_create
    xprocess_query:33
    channel_connect:slogger_t,pci_server_t,devb_t,random_t,io_usb_t
    settypeid:io_sock_t__run
};
derive_type io_sock_t run io_sock_t__run;

# === Rules for type io_sock_t__run ============
allow io_sock_t__run self:ability {
    nonroot
    getid
    channel_connect:devb_t,io_usb_t
};

# === Rules for type io_usb_t ============
allow_attach io_usb_t {
    mount+:/dev/usb/io-usb-otg
    mount+:/dev/usb/ctrl
    mount+:/dev/usb/devu-uhci.so
    mount+:/dev/usb/devu-hcd-ehci.so
    mount+:/dev/usb/devu-hcd-xhci.so
};
allow io_usb_t self:ability {
    nonroot
    pathspace
    prot_exec
    io:0
    map_fixed
    public_channel
    xprocess_query:44
    channel_connect:slogger_t,devb_t
    xprocess_mem_read:33
};

# === Rules for type mqueue_t ============
allow_attach mqueue_t {
    mqueue:/
    /dev/mqueue
};
allow mqueue_t self:ability {
    nonroot
    pathspace
    confset:19-20,32
    prot_exec
    map_fixed
    public_channel
    settypeid:mqueue_t__run
};
derive_type mqueue_t run mqueue_t__run;

# === Rules for type pci_server_t ============
allow_attach pci_server_t {
    all+:/dev/pci/server_id_1
};
allow pci_server_t self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    mem_phys:0-4095,2147483648-2147487743,3758096384-3758100479,4026531840-4026535935,4273471488-4273475583
    mem_peer:33
    mem_lock
    prot_exec
    io:0
    map_fixed
    public_channel
    xprocess_query:34
    channel_connect:slogger_t
};

# === Rules for type pipe_t ============
allow_attach pipe_t {
    pipe:/
    /dev/pipe
};
allow pipe_t self:ability {
    nonroot
    pathspace
    prot_exec
    signal:13
    map_fixed
    public_channel
    settypeid:pipe_t__run
};
derive_type pipe_t run pipe_t__run;

# === Rules for type pipe_t__run ============
allow pipe_t__run self:ability {
    nonroot
    signal:13
};

# === Rules for type qconn_t ============
allow_attach qconn_t {
    /dev/profiler
};
allow qconn_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    channel_connect:devb_t,io_sock_t
    xprocess_debug:29
    xprocess_mem_read:29
    network/jailroot
};

# === Rules for type random_t ============
allow_attach random_t {
    /dev/random
    /dev/urandom
};
allow random_t self:ability {
    nonroot
    srandom
    channel_connect:devb_t
    settypeid:random_t__run
};
allow random_t self:ability {
    setuid:22
    setgid:22
    pathspace
    mem_lock
    prot_exec
    map_fixed
    public_channel
    channel_connect:slogger_t
};
derive_type random_t run random_t__run;

# === Rules for type random_t__run ============
allow random_t__run self:ability {
    nonroot
    srandom
};

# === Rules for type slogger_t ============
allow_attach slogger_t {
    /dev/slog
    /dev/slog2/notify
    /dev/slog2/stdout
    /dev/slog2/stderr
    /dev/console
};
allow slogger_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    xprocess_query:0,37-38,47
    channel_connect:random_t
    settypeid:slogger_t__run
};
derive_type slogger_t run slogger_t__run;

# === Rules for type slogger_t__run ============
allow slogger_t__run self:ability {
    nonroot
    xprocess_query:0,37-38,47
    channel_connect:random_t
};

# === Rules for type spo2d1_t ============
allow_attach spo2d1_t {
    /dev/spo2/1
};
allow spo2d1_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:io_sock_t
    network/jailroot
};

# === Rules for type spo2d2_t ============
allow_attach spo2d2_t {
    /dev/spo2/2
};
allow spo2d2_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:io_sock_t
    network/jailroot
};

# === Rules for type spo2d3_t ============
allow_attach spo2d3_t {
    /dev/spo2/3
};
allow spo2d3_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:io_sock_t
    network/jailroot
};

# === Rules for type sshd_t ============
allow sshd_t self:ability {
    nonroot
    spawn
    fork
    prot_exec
    pgrp
    map_fixed
    chroot:0
    channel_connect:slogger_t,devb_t,random_t,pipe_t,io_sock_t
    settypeid:sshd_t__privsep,user_root_t
    network/privport
    network/jailroot
};
allow sshd_t self:ability {
    gain_priv:setuid,setgid
};
derive_type sshd_t privsep sshd_t__privsep;

# === Rules for type sshd_t__privsep ============
allow sshd_t__privsep self:ability {
    nonroot
    setuid:15
    setgid:15
};

# === Rules for type station_t ============
allow station_t self:ability {
    prot_exec
    map_fixed
    channel_connect:io_sock_t,titractl1_t,titractl2_t,titractl3_t
    network/jailroot
};

# === Rules for type titractl1_t ============
allow_attach titractl1_t {
    /dev/titra/cot1
};
allow titractl1_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:devb_t,ham_t,spo2d1_t,valved1_t
};

# === Rules for type titractl2_t ============
allow_attach titractl2_t {
    /dev/titra/cot2
};
allow titractl2_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:devb_t,ham_t,spo2d2_t,valved2_t
};

# === Rules for type titractl3_t ============
allow_attach titractl3_t {
    /dev/titra/cot3
};
allow titractl3_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:devb_t,ham_t,spo2d3_t,valved3_t
};

# === Rules for type user_root_t ============
allow user_root_t self:ability {
    nonroot
    setuid:0
    setgid:0
    fork
    channel_connect:devb_t,io_sock_t
    network/jailroot
};
allow user_root_t self:ability {
    setgid:0
    spawn
    prot_exec
    pgrp
    map_fixed
    xprocess_query:20-22,24-25,29-30,33-34,37-38,43-44,47-48
    channel_connect:slogger_t,devb_t,pipe_t,titractl1_t,titractl2_t,titractl3_t
    settypeid:titractl2_t,station_t
};

# === Rules for type valved1_t ============
allow_attach valved1_t {
    /dev/valve/1
};
allow valved1_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:io_sock_t
    network/jailroot
};

# === Rules for type valved2_t ============
allow_attach valved2_t {
    /dev/valve/2
};
allow valved2_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:io_sock_t
    network/jailroot
};

# === Rules for type valved3_t ============
allow_attach valved3_t {
    /dev/valve/3
};
allow valved3_t self:ability {
    pathspace
    prot_exec
    priority:0-253
    map_fixed
    public_channel
    channel_connect:io_sock_t
    network/jailroot
};

# === Mount point permission rules ============
# These represent uses of secpol_resmgr_attach(). By using mount_point
# rules you can set the permissions used for these mount points.
# mount_point ... /dev/console;
# mount_point ... /dev/pci/server_id_1;
# mount_point ... /dev/ser1;
# mount_point ... /dev/ser2;
# mount_point ... /dev/fsmgr;
# mount_point ... /dev/fsnotify;
# mount_point ... /dev/random;
# mount_point ... /dev/socket/1;
# mount_point ... /dev/socket/2;
# mount_point ... /dev/socket/28;
# mount_point ... /dev/socket/17;
# mount_point ... /dev/socket/38;
# mount_point ... /dev/socket/27;
# mount_point ... /dev/tun;
# mount_point ... /dev/tap;
# mount_point ... /dev/vmnet;
# mount_point ... /;
# mount_point ... /dev/io-sock/;
# mount_point ... /dev/bpf;
# mount_point ... /dev/netmap;
# mount_point ... /dev/pfil;
# mount_point ... /dev/pf;
# mount_point ... /proc/ham;
# mount_point ... /proc/ham/.ctl;
